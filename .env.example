# Copy to .env.local for local development. Never commit real values.
# Locally the database is PGlite (in-process Postgres); production values live in Vercel (see README).
DATABASE_URL=pglite:./.pglite/dev
DATABASE_URL_TEST=pglite:memory   # Vitest: a fresh in-memory database per worker
BETTER_AUTH_SECRET=               # openssl rand -base64 32
BETTER_AUTH_URL=http://localhost:3000
EMAIL_FROM="HomeKeeper <onboarding@resend.dev>"
CRON_SECRET=                      # openssl rand -hex 32
# Optional locally: without these, emails are logged to the terminal and photo uploads fail with an error.
RESEND_API_KEY=
BLOB_READ_WRITE_TOKEN=
